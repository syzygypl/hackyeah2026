  },
  {
   "id": "SIG-SSTI",
   "name": "Server-side template injection",
   "category": "code_execution",
   "severity": "critical",
   "regex": "\\{\\{[^}]{0,200}(__class__|__subclasses__|__globals__|__builtins__|__mro__|__init__|config\\.items|request\\.application)|\\{%[^%]{0,200}(__class__|__subclasses__|__globals__|import\\s+os)|\\{\\{\\s*\\d+\\s*\\*\\s*\\d+\\s*\\}\\}|\\$\\{\\s*\\d+\\s*\\*\\s*\\d+\\s*\\}",
   "ref": "Jinja2 / Twig SSTI to RCE (OWASP LLM05)"
  },
  {
   "id": "SIG-XXE",
   "name": "XML external entity",
   "category": "code_execution",
   "severity": "high",
   "regex": "<!DOCTYPE[\\s\\S]{0,300}<!ENTITY[\\s\\S]{0,300}(SYSTEM|PUBLIC)",
   "ref": "XXE local file read / SSRF"
  },
  {
   "id": "SIG-MD-EXFIL",
   "name": "Markdown auto-fetch image / link carrying data in the query string",
   "category": "data_exfiltration",
   "severity": "medium",
   "regex": "!\\[[^\\]]{0,100}\\]\\(\\s*https?://[^)\\s]*\\?[^)\\s]*=[^)\\s]+|\\[[^\\]]{0,100}\\]\\(\\s*https?://[^)\\s]*\\?[^)\\s]*=[A-Za-z0-9+/_=-]{16,}",
   "ref": "Markdown image exfiltration (Bing Chat, ChatGPT plugins, Slack AI 2023-24)"
  }
