  {
   "id": "SIG-SSRF-METADATA",
   "name": "SSRF to cloud metadata, loopback or private network",
   "category": "ssrf",
   "severity": "critical",
   "regex": "169\\.254\\.169\\.254|metadata\\.google\\.internal|metadata\\.azure\\.com|/latest/meta-data|/computeMetadata/|https?://(localhost|127\\.\\d{1,3}\\.\\d{1,3}\\.\\d{1,3}|0\\.0\\.0\\.0|\\[::1?\\]|10\\.\\d{1,3}\\.\\d{1,3}\\.\\d{1,3}|192\\.168\\.\\d{1,3}\\.\\d{1,3}|172\\.(1[6-9]|2\\d|3[01])\\.\\d{1,3}\\.\\d{1,3}|0x[0-9a-f]{8}|\\d{8,10})(?=[:/?#]|$|\\s)",
