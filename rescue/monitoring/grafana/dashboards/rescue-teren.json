{
 "uid": "rescue-teren",
 "title": "Rescue Locator - Teren",
 "tags": [
  "rescue",
  "hackyeah2026"
 ],
 "timezone": "browser",
 "schemaVersion": 39,
 "version": 1,
 "refresh": "5s",
 "time": {
  "from": "now-15m",
  "to": "now"
 },
 "panels": [
  {
   "id": 1,
   "title": "LLM lokalny",
   "type": "stat",
   "datasource": {
    "type": "prometheus",
    "uid": "rescue-prom"
   },
   "gridPos": {
    "x": 0,
    "y": 0,
    "w": 4,
    "h": 4
   },
   "targets": [
    {
     "expr": "max(rescue_llm_up)",
     "instant": true,
     "datasource": {
      "type": "prometheus",
      "uid": "rescue-prom"
     },
     "refId": "A"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "none",
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "orange",
        "value": null
       },
       {
        "color": "green",
        "value": 1
       }
      ]
     },
     "mappings": [
      {
       "type": "value",
       "options": {
        "0": {
         "text": "OFF - reguły",
         "color": "orange"
        },
        "1": {
         "text": "działa",
         "color": "green"
        }
       }
      }
     ]
    },
    "overrides": []
   },
   "options": {
    "colorMode": "background",
    "graphMode": "none",
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ]
    }
   }
  },
  {
   "id": 2,
   "title": "Zespoły w kontakcie",
   "type": "stat",
   "datasource": {
    "type": "prometheus",
    "uid": "rescue-prom"
   },
   "gridPos": {
    "x": 4,
    "y": 0,
    "w": 4,
    "h": 4
   },
   "targets": [
    {
     "expr": "count((time() - rescue_client_last_report_timestamp_seconds) <= on(instance) group_left() rescue_silent_threshold_seconds) or vector(0)",
     "instant": true,
     "datasource": {
      "type": "prometheus",
      "uid": "rescue-prom"
     },
     "refId": "A"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "none",
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "green",
        "value": null
       }
      ]
     },
     "mappings": []
    },
    "overrides": []
   },
   "options": {
    "colorMode": "value",
    "graphMode": "none",
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ]
    }
   }
  },
  {
   "id": 3,
   "title": "Zespoły w ciszy",
   "type": "stat",
   "datasource": {
    "type": "prometheus",
    "uid": "rescue-prom"
   },
   "gridPos": {
    "x": 8,
    "y": 0,
    "w": 4,
    "h": 4
   },
   "targets": [
    {
     "expr": "count(((time() - rescue_client_last_report_timestamp_seconds) > on(instance) group_left() rescue_silent_threshold_seconds) and (time() - rescue_client_last_report_timestamp_seconds) < 7200) or vector(0)",
     "instant": true,
     "datasource": {
      "type": "prometheus",
      "uid": "rescue-prom"
     },
     "refId": "A"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "none",
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "green",
        "value": null
       },
       {
        "color": "red",
        "value": 1
       }
      ]
     },
     "mappings": []
    },
    "overrides": []
   },
   "options": {
    "colorMode": "background",
    "graphMode": "none",
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ]
    }
   }
  },
  {
   "id": 4,
   "title": "Meldunki (razem)",
   "type": "stat",
   "datasource": {
    "type": "prometheus",
    "uid": "rescue-prom"
   },
   "gridPos": {
    "x": 12,
    "y": 0,
    "w": 4,
    "h": 4
   },
   "targets": [
    {
     "expr": "sum(rescue_reports_received_total) or vector(0)",
     "instant": true,
     "datasource": {
      "type": "prometheus",
      "uid": "rescue-prom"
     },
     "refId": "A"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "none",
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "green",
        "value": null
       }
      ]
     },
     "mappings": []
    },
    "overrides": []
   },
   "options": {
    "colorMode": "value",
    "graphMode": "area",
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ]
    }
   }
  },
  {
   "id": 5,
   "title": "Udział LLM vs reguły",
   "type": "piechart",
   "datasource": {
    "type": "prometheus",
    "uid": "rescue-prom"
   },
   "gridPos": {
    "x": 16,
    "y": 0,
    "w": 8,
    "h": 8
   },
   "targets": [
    {
     "expr": "sum by (parsed_by) (rescue_reports_received_total)",
     "legendFormat": "{{parsed_by}}",
     "instant": true,
     "datasource": {
      "type": "prometheus",
      "uid": "rescue-prom"
     },
     "refId": "A"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "none"
    },
    "overrides": []
   },
   "options": {
    "pieType": "donut",
    "legend": {
     "displayMode": "table",
     "placement": "right",
     "values": [
      "value",
      "percent"
     ]
    },
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ]
    }
   }
  },
  {
   "id": 6,
   "title": "Meldunki / min wg zespołu",
   "type": "timeseries",
   "datasource": {
    "type": "prometheus",
    "uid": "rescue-prom"
   },
   "gridPos": {
    "x": 0,
    "y": 4,
    "w": 16,
    "h": 8
   },
   "targets": [
    {
     "expr": "sum by (team) (rate(rescue_reports_received_total[1m])) * 60",
     "legendFormat": "{{team}}",
     "datasource": {
      "type": "prometheus",
      "uid": "rescue-prom"
     },
     "refId": "A"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "none",
     "custom": {
      "drawStyle": "line",
      "lineWidth": 2,
      "fillOpacity": 10
     }
    },
    "overrides": []
   }
  },
  {
   "id": 7,
   "title": "Ostatni meldunek per klient",
   "type": "table",
   "datasource": {
    "type": "prometheus",
    "uid": "rescue-prom"
   },
   "gridPos": {
    "x": 0,
    "y": 12,
    "w": 12,
    "h": 9
   },
   "targets": [
    {
     "expr": "time() - rescue_client_last_report_timestamp_seconds",
     "instant": true,
     "format": "table",
     "datasource": {
      "type": "prometheus",
      "uid": "rescue-prom"
     },
     "refId": "A"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "s",
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "green",
        "value": null
       },
       {
        "color": "orange",
        "value": 300
       },
       {
        "color": "red",
        "value": 600
       }
      ]
     }
    },
    "overrides": [
     {
      "matcher": {
       "id": "byName",
       "options": "Value"
      },
      "properties": [
       {
        "id": "displayName",
        "value": "ostatni meldunek (s temu)"
       },
       {
        "id": "custom.cellOptions",
        "value": {
         "type": "color-background"
        }
       }
      ]
     }
    ]
   },
   "transformations": [
    {
     "id": "organize",
     "options": {
      "excludeByName": {
       "Time": true,
       "__name__": true,
       "job": true,
       "service": true
      },
      "renameByName": {
       "client_id": "klient",
       "team": "zespół",
       "instance": "serwer"
      }
     }
    },
    {
     "id": "sortBy",
     "options": {
      "sort": [
       {
        "field": "Value",
        "desc": true
       }
      ]
     }
    }
   ],
   "description": "Czerwone > 10 min (produkcyjny próg). W demo próg jest krótszy: patrz alert ClientSilent."
  },
  {
   "id": 8,
   "title": "Czas parsowania p50 / p95",
   "type": "timeseries",
   "datasource": {
    "type": "prometheus",
    "uid": "rescue-prom"
   },
   "gridPos": {
    "x": 12,
    "y": 12,
    "w": 12,
    "h": 9
   },
   "targets": [
    {
     "expr": "histogram_quantile(0.5, sum by (le, parsed_by) (rate(rescue_report_parse_seconds_bucket[5m])))",
     "legendFormat": "p50 {{parsed_by}}",
     "datasource": {
      "type": "prometheus",
      "uid": "rescue-prom"
     },
     "refId": "A"
    },
    {
     "expr": "histogram_quantile(0.95, sum by (le, parsed_by) (rate(rescue_report_parse_seconds_bucket[5m])))",
     "legendFormat": "p95 {{parsed_by}}",
     "datasource": {
      "type": "prometheus",
      "uid": "rescue-prom"
     },
     "refId": "B"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "s",
     "custom": {
      "drawStyle": "line",
      "lineWidth": 2
     }
    },
    "overrides": []
   }
  },
  {
   "id": 9,
   "title": "Odrzucone żądania wg powodu (/ min)",
   "type": "timeseries",
   "datasource": {
    "type": "prometheus",
    "uid": "rescue-prom"
   },
   "gridPos": {
    "x": 0,
    "y": 21,
    "w": 12,
    "h": 8
   },
   "targets": [
    {
     "expr": "sum by (reason) (increase(rescue_reports_rejected_total[1m]))",
     "legendFormat": "{{reason}}",
     "datasource": {
      "type": "prometheus",
      "uid": "rescue-prom"
     },
     "refId": "A"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "none",
     "custom": {
      "drawStyle": "bars",
      "fillOpacity": 60,
      "stacking": {
       "mode": "normal"
      }
     },
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "green",
        "value": null
       },
       {
        "color": "red",
        "value": 5
       }
      ]
     }
    },
    "overrides": []
   },
   "description": "> 5 / min = alert RejectSpike (możliwy atak na PIN)."
  },
  {
   "id": 10,
   "title": "LLM up (historia)",
   "type": "state-timeline",
   "datasource": {
    "type": "prometheus",
    "uid": "rescue-prom"
   },
   "gridPos": {
    "x": 12,
    "y": 21,
    "w": 12,
    "h": 4
   },
   "targets": [
    {
     "expr": "rescue_llm_up",
     "legendFormat": "{{job}}",
     "datasource": {
      "type": "prometheus",
      "uid": "rescue-prom"
     },
     "refId": "A"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "mappings": [
      {
       "type": "value",
       "options": {
        "0": {
         "text": "reguły",
         "color": "orange"
        },
        "1": {
         "text": "LLM",
         "color": "green"
        }
       }
      }
     ],
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "orange",
        "value": null
       },
       {
        "color": "green",
        "value": 1
       }
      ]
     }
    },
    "overrides": []
   }
  },
  {
   "id": 11,
   "title": "Alerty (aktywne)",
   "type": "table",
   "datasource": {
    "type": "prometheus",
    "uid": "rescue-prom"
   },
   "gridPos": {
    "x": 12,
    "y": 25,
    "w": 12,
    "h": 4
   },
   "targets": [
    {
     "expr": "ALERTS{alertstate=\"firing\"}",
     "instant": true,
     "format": "table",
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "rescue-prom"
     }
    }
   ],
   "options": {},
   "fieldConfig": {
    "defaults": {},
    "overrides": []
   },
   "transformations": [
    {
     "id": "organize",
     "options": {
      "excludeByName": {
       "Time": true,
       "__name__": true,
       "Value": true,
       "job": true,
       "service": true,
       "alertstate": true
      },
      "renameByName": {
       "alertname": "alert",
       "client_id": "klient",
       "team": "zespół",
       "instance": "serwer"
      }
     }
    }
   ]
  },
  {
   "id": 12,
   "title": "HTTP wg ścieżki i kodu (/ min)",
   "type": "timeseries",
   "datasource": {
    "type": "prometheus",
    "uid": "rescue-prom"
   },
   "gridPos": {
    "x": 0,
    "y": 29,
    "w": 24,
    "h": 7
   },
   "targets": [
    {
     "expr": "sum by (path, code) (rate(rescue_http_requests_total[1m])) * 60",
     "legendFormat": "{{path}} {{code}}",
     "datasource": {
      "type": "prometheus",
      "uid": "rescue-prom"
     },
     "refId": "A"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "none"
    },
    "overrides": []
   }
  }
 ],
 "editable": true,
 "graphTooltip": 1,
 "templating": {
  "list": []
 },
 "annotations": {
  "list": []
 }
}